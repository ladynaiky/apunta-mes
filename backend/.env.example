# Copia este archivo como .env y rellena los valores. El .env nunca se sube a git.

PORT=3000

# Cadena de conexión de MongoDB Atlas (la pegas tú en la fase 2)
MONGODB_URI=

# Base de datos solo para los tests e2e (otra base de datos: …/apunta-mes-test?…).
# Se vacía en cada ejecución: NUNCA la misma que MONGODB_URI.
TEST_MONGODB_URI=

# Secreto para firmar los JWT: cadena larga y aleatoria (la escribes tú)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Orígenes permitidos (ng serve, Ionic serve, Capacitor Android)
CORS_ORIGINS=http://localhost:4200,http://localhost:8100,capacitor://localhost,http://localhost

# Modo demo: activa la cabecera X-Demo-State y POST /api/demo/reset
DEMO_MODE=true

# Fecha «de hoy» de la demo (vacío = fecha real)
DEMO_TODAY=

# Reiniciar los datos del usuario de demo cada día (solo en modo demo; por defecto, true)
DEMO_DAILY_RESET=true

# Usuario de demo que crea el script de datos
DEMO_USER_EMAIL=demo@apunta.cat
DEMO_USER_PASSWORD=
